# ============================================================
#  pdf_profile_pipeline configuration
#  Copy to .env and fill in real values. .env is git-ignored.
# ============================================================

# --- Neon Postgres ---
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
TARGET_TABLE=profiles

# --- Cloudflare R2 (S3-compatible) ---
STORAGE_ENABLED=true
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY=<r2-access-key>
S3_SECRET_KEY=<r2-secret-key>
# Public base URL; with S3_PUBLIC=true the DB stores a full public URL,
# otherwise it stores an internal path like /files/resumes/...
S3_PUBLIC_BASE_URL=https://<public-domain-or-r2-dev-url>
S3_PUBLIC=true
S3_ACL=
# Key prefix for uploaded PDFs: <prefix>/<specialty-or-state>/<sha256>.pdf
R2_KEY_PREFIX=resumes

# --- Qwen2.5 extraction model (OpenAI-compatible endpoint) ---
LLM_ENABLED=true
# Ollama:   http://localhost:11434/v1
# vLLM:     http://localhost:8000/v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=180
LLM_MAX_INPUT_CHARS=18000
LLM_TEMPERATURE=0

# --- SharePoint / OneDrive (Microsoft Graph) ---
ONEDRIVE_CLIENT_ID=<entra-app-client-id>
ONEDRIVE_TENANT=common
# Set only for app-only (client credentials) access; leave blank for device login.
ONEDRIVE_CLIENT_SECRET=
